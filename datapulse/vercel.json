{
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "/api/bridge?__u=/api/v1/:path*"
    },
    {
      "source": "/v1/:path*",
      "destination": "/api/bridge?__u=/v1/:path*"
    },
    {
      "source": "/health",
      "destination": "/api/bridge?__u=/health"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
