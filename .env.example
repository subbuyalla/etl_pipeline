# Copy to ".env" and fill in your values. Do not commit .env.

# --- Option A: full SQLAlchemy URL ---
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/DATABASE

# --- Option B: separate fields (used if DATABASE_URL is empty) ---
DB_DRIVER=mysql+pymysql
# Local metadata MySQL for development (required). No cloud default in code.
# docker compose: user obs / password obs  OR local MySQL root.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=metadata
# Optional: DB_TOOL_SNAPSHOT_TTL_SECONDS=300

# Fernet master key for encrypting tool secrets in obs_secrets (NOT the tool passwords themselves).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_MASTER_KEY=replace-with-fernet-key

# Poller (docker-compose poller service; optional for API-only deploy)
# SYNC_INTERVAL_SECONDS=300

TENANT_ID=demo

# Optional deep links from Metadata API into native ETL UIs
# AIRFLOW_BASE_URL=https://airflow.example.com
# DBT_CLOUD_BASE_URL=https://cloud.getdbt.com/deploy/ACCOUNT/projects/PROJECT
# GLUE_CONSOLE_REGION=us-east-1
# ADF_PORTAL_BASE_URL=https://adf.azure.com

# Airflow connector (live)
# AIRFLOW_USERNAME=
# AIRFLOW_PASSWORD=
# AIRFLOW_TOKEN=

# --- stock_etl (defaults in pipelines.py) ---
# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_USER=
# SNOWFLAKE_PASSWORD=
# DBT_CLOUD_API_TOKEN=
# DBT_ACCOUNT_ID=
# DBT_PROJECT_ID=
# DBT_API_BASE=

# --- ecommerce_etl ---
# ECOM_SNOWFLAKE_ACCOUNT=jd97000.ap-southeast-7.aws
# ECOM_SNOWFLAKE_USER=
# ECOM_SNOWFLAKE_WAREHOUSE=ECOMMERCE_WH
# ECOM_SNOWFLAKE_DATABASE=ECOMMERCE
# ECOM_SF_SOURCE_SCHEMA=SRC_DATA
# ECOM_SF_TARGET_SCHEMA=CLEAN_DATA
# ECOM_SF_SOURCE_TABLES=
# ECOM_SF_TARGET_TABLES=MY_FIRST_DBT_MODEL
# ECOM_DBT_ACCOUNT_ID=70506183153835
# ECOM_DBT_PROJECT_ID=70506183136444
# ECOM_DBT_JOB_ID=
# ECOM_DBT_API_BASE=https://eg250.us1.dbt.com/api/v2
# ECOM_DBT_CLOUD_API_TOKEN=

# --- hr_etl ---
# HR_SNOWFLAKE_ACCOUNT=jd97000.ap-southeast-7.aws
# HR_SNOWFLAKE_USER=
# HR_SNOWFLAKE_WAREHOUSE=HR_ANALYTICS_WH
# HR_SNOWFLAKE_DATABASE=HR_ANALYTICS
# HR_SF_SOURCE_SCHEMA=RAW_DATA
# HR_SF_TARGET_SCHEMA=FINAL_DATA
# HR_SF_SOURCE_TABLES=RAW_EMPLOYEES
# HR_SF_TARGET_TABLES=DIM_EMPLOYEES
# HR_DBT_ACCOUNT_ID=70506183153835
# HR_DBT_PROJECT_ID=70506183136587
# HR_DBT_JOB_ID=
# HR_DBT_API_BASE=https://eg250.us1.dbt.com/api/v2
# HR_DBT_CLOUD_API_TOKEN=

# --- Grafana (auto dashboard via Metadata API) ---
# UI example: http://16.113.97.80:3000/d/adsng4g/new-dashboard
GRAFANA_URL=http://16.113.97.80:3000
# Service account token (Editor is enough). Do not commit the real token.
GRAFANA_TOKEN=
# Optional: pin existing MySQL datasource uid; leave empty to auto-detect/create
GRAFANA_DATASOURCE_UID=
GRAFANA_DASHBOARD_UID=etl-obs
GRAFANA_DASHBOARD_TITLE=ETL Observability

# Public API base (webhook URLs returned by /health and /)
PUBLIC_BASE_URL=https://etl-pipeline-lemon.vercel.app
