# Copy to ".env" and fill in your values. Do not commit .env.

# --- Option A: full SQLAlchemy URL ---
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/DATABASE

# --- Option B: separate fields (used if DATABASE_URL is empty) ---
DB_DRIVER=mysql+pymysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=metadata

TENANT_ID=demo

# Optional deep links from Metadata API into native ETL UIs
# AIRFLOW_BASE_URL=https://airflow.example.com
# DBT_CLOUD_BASE_URL=https://cloud.getdbt.com/deploy/ACCOUNT/projects/PROJECT
# GLUE_CONSOLE_REGION=us-east-1
# ADF_PORTAL_BASE_URL=https://adf.azure.com

# Airflow connector (live)
# AIRFLOW_USERNAME=
# AIRFLOW_PASSWORD=
# AIRFLOW_TOKEN=
