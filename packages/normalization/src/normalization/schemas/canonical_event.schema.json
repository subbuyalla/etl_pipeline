{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/etl/canonical_event.schema.json",
  "title": "CanonicalEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "occurred_at",
    "tenant_id",
    "source_system",
    "source_tool",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1,
      "description": "Idempotent id; same id re-ingested must upsert, not duplicate"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "pipeline.execution.started.v1",
        "pipeline.execution.succeeded.v1",
        "pipeline.execution.failed.v1",
        "task.execution.started.v1",
        "task.execution.succeeded.v1",
        "task.execution.failed.v1",
        "task.execution.retried.v1",
        "dataset.discovered.v1",
        "dataset.freshness.breached.v1",
        "dataset.volume.anomaly.v1",
        "dataset.schema.changed.v1",
        "dataset.distribution.anomaly.v1",
        "lineage.edge.upserted.v1",
        "alert.raised.v1",
        "monitor.check.completed.v1"
      ]
    },
    "occurred_at": { "type": "string", "format": "date-time" },
    "tenant_id": { "type": "string", "minLength": 1 },
    "source_system": { "type": "string", "minLength": 1 },
    "source_tool": {
      "type": "string",
      "description": "Canonical tool id from the registry (airflow, snowflake, ...)"
    },
    "connector_instance_id": { "type": ["string", "null"] },
    "payload": { "type": "object" }
  }
}
